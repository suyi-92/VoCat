# ---- Binaries / build outputs ----
/vocat
/vocat.exe
/build/
/wintun/
/release.py
/build/vocat
/build/vocat-linux-amd64
/build/vocat-linux-amd64.exe
*.exe
*.dll
*.so
*.dylib
/fix

# ---- Cookie / secret files (NEVER commit) ----
vc.jar
*.cookies
*.session
.env
.env.*
!.env.example

# ---- Frontend build products ----
web/dist/
web/build/
web/node_modules/

# ---- Go build ----
*.test
*.out

# ---- Python (build/ helpers) ----
build/__pycache__/
__pycache__/
*.pyc
# Local-only helpers carry internal hostnames/credentials and must never be
# committed. The whole build directory and the root release.py are ignored.
build/*.py

/extension/

# ---- Docs / scratch ----
*.md
!README.md
!MODIFICATIONS.md
!docs/**/*.md
*.txt
!LICENSES/*.txt
build/lists/

# ---- Editor / IDE ----
.vscode/
.idea/

# ---- OS junk ----
.DS_Store
Thumbs.db

# ---- Claude Code / agent ----
.claude/
.worktrees/

# ---- Checked-in Windows ready-to-run bundles ----
# Keep runtime state, logs, dependency caches, and arbitrary build output out
# of Git. Only the reviewed launchers, checksums, signed binaries, and license
# material below are intentionally versioned.
/dist/*
!/dist/SHA256SUMS
!/dist/start-vocat.cmd
!/dist/start-vocat.ps1
!/dist/stop-vocat.cmd
!/dist/stop-vocat.ps1
!/dist/windows-amd64/
!/dist/windows-arm64/
/dist/windows-amd64/*
!/dist/windows-amd64/LICENSE
!/dist/windows-amd64/NOTICE
!/dist/windows-amd64/vocat.exe
!/dist/windows-amd64/wintun.dll
!/dist/windows-amd64/xray.exe
!/dist/windows-amd64/WINTUN-LICENSE.txt
!/dist/windows-amd64/XRAY-LICENSE.txt
!/dist/windows-amd64/LICENSES/
/dist/windows-amd64/LICENSES/*
!/dist/windows-amd64/LICENSES/*.txt
/dist/windows-arm64/*
!/dist/windows-arm64/LICENSE
!/dist/windows-arm64/NOTICE
!/dist/windows-arm64/vocat.exe
!/dist/windows-arm64/wintun.dll
!/dist/windows-arm64/xray.exe
!/dist/windows-arm64/WINTUN-LICENSE.txt
!/dist/windows-arm64/XRAY-LICENSE.txt
!/dist/windows-arm64/LICENSES/
/dist/windows-arm64/LICENSES/*
!/dist/windows-arm64/LICENSES/*.txt
